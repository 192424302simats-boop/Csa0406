6. Pre-emptive Priority Scheduling
#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pr[20];
    int ct[20], wt[20], tat[20];
    float avgwt = 0, avgtat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter AT, BT and Priority for P%d: ", i + 1);
        scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
        rt[i] = bt[i];
    }

    while (completed < n) {
        int index = -1, best = 9999;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && pr[i] < best) {
                best = pr[i];
                index = i;
            }
        }

        if (index == -1) {
            time++;
        } else {
            rt[index]--;
            time++;

            if (rt[index] == 0) {
                completed++;
                ct[index] = time;
                tat[index] = ct[index] - at[index];
                wt[index] = tat[index] - bt[index];

                avgwt += wt[index];
                avgtat += tat[index];
            }
        }
    }

    printf("\nPID\tAT\tBT\tPR\tCT\tWT\tTAT\n");

    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i],
               ct[i], wt[i], tat[i]);

    printf("\nAverage WT = %.2f", avgwt / n);
    printf("\nAverage TAT = %.2f\n", avgtat / n);

    return 0;
}

7. Non-Preemptive SJF
#include <stdio.h>

int main() {
    int n, i, j, time = 0, completed = 0;
    int at[20], bt[20], done[20] = {0};
    int ct[20], wt[20], tat[20];
    float avgwt = 0, avgtat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter AT and BT for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
    }

    while (completed < n) {
        int index = -1, minbt = 9999;

        for (i = 0; i < n; i++) {
            if (!done[i] && at[i] <= time && bt[i] < minbt) {
                minbt = bt[i];
                index = i;
            }
        }

        if (index == -1) {
            time++;
        } else {
            time += bt[index];
            ct[index] = time;
            tat[index] = ct[index] - at[index];
            wt[index] = tat[index] - bt[index];

            avgwt += wt[index];
            avgtat += tat[index];

            done[index] = 1;
            completed++;
        }
    }

    printf("\nPID\tAT\tBT\tCT\tWT\tTAT\n");

    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i],
               ct[i], wt[i], tat[i]);

    printf("\nAverage WT = %.2f", avgwt / n);
    printf("\nAverage TAT = %.2f\n", avgtat / n);

    return 0;
}

8. Round Robin Scheduling
#include <stdio.h>

int main() {
    int n, tq, i, time = 0, completed = 0;
    int bt[20], rt[20], ct[20], wt[20], tat[20];
    float avgwt = 0, avgtat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter Burst Time for P%d: ", i + 1);
        scanf("%d", &bt[i]);
        rt[i] = bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    while (completed < n) {
        for (i = 0; i < n; i++) {
            if (rt[i] > 0) {
                if (rt[i] > tq) {
                    time += tq;
                    rt[i] -= tq;
                } else {
                    time += rt[i];
                    rt[i] = 0;
                    ct[i] = time;
                    completed++;
                }
            }
        }
    }

    printf("\nPID\tBT\tCT\tWT\tTAT\n");

    for (i = 0; i < n; i++) {
        tat[i] = ct[i];
        wt[i] = tat[i] - bt[i];

        avgwt += wt[i];
        avgtat += tat[i];

        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, bt[i], ct[i], wt[i], tat[i]);
    }

    printf("\nAverage WT = %.2f", avgwt / n);
    printf("\nAverage TAT = %.2f\n", avgtat / n);

    return 0;
}

9. IPC Using Shared Memory
#include <stdio.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <string.h>

int main() {
    int shmid;
    char *str;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);
    str = (char *)shmat(shmid, NULL, 0);

    if (fork() == 0) {
        sleep(1);
        printf("Child received: %s\n", str);
        shmdt(str);
    } else {
        strcpy(str, "Hello from Parent");
        wait(NULL);
        shmdt(str);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}

10. IPC Using Message Queue
#include <stdio.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>

struct message {
    long type;
    char text[100];
};

int main() {
    int msgid;
    struct message msg;

    msgid = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);

    if (fork() == 0) {
        msgrcv(msgid, &msg, sizeof(msg.text), 1, 0);
        printf("Child received: %s\n", msg.text);
    } else {
        msg.type = 1;
        sprintf(msg.text, "Hello from Parent");

        msgsnd(msgid, &msg, sizeof(msg.text), 0);
        wait(NULL);

        msgctl(msgid, IPC_RMID, NULL);
    }

    return 0;
}

11. Multithreading Using C
#include <stdio.h>
#include <pthread.h>

void *task(void *arg) {
    int id = *(int *)arg;

    printf("Thread %d is running\n", id);

    return NULL;
}

int main() {
    pthread_t t1, t2;
    int a = 1, b = 2;

    pthread_create(&t1, NULL, task, &a);
    pthread_create(&t2, NULL, task, &b);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    printf("Both threads completed\n");

    return 0;
}


